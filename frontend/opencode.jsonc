// File: frontend/opencode.jsonc
//
// Assumes the local directory layout:
//   kencleng-workspace/
//   ├── kencleng/
//   └── harscode-workspace/
//
// Run OpenCode from frontend/. Frontend and backend remain separate
// production write scopes by default. Shared docs/API are referenced
// explicitly for context without exposing backend/ as normal write scope.
{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "workspace": {
      "path": "../../harscode-workspace",
      "description": "Generic portable workflow and engineering best-practices from Harscode, including current React/frontend guidance. Harscode owns the per-feature lifecycle; Kencleng owns project-specific architecture, product/design truth, orchestration, and project status. Read workflow/README.md and best-practices/index.md as entry points."
    },
    "docs": {
      "path": "../docs",
      "description": "Kencleng project knowledge. Domain/feature truth lives under numbered docs/spec/<domain-dir>/ directories; docs/ui-ux/ owns the active Sunlit Editorial product-design, UX, visual-system, asset, page-map, and selected-direction authorities; docs/project/ owns frontend architecture, reboot/readiness context, and current project status; docs/kencleng-agentic-workflow.md owns project orchestration. Removed prototype/design generations are Git history, not active authority. Use root/frontend AGENTS.md to route to the smallest relevant authority set."
    },
    "api": {
      "path": "../api",
      "description": "OpenAPI 3.0.3 contract used by openapi-typescript. Check the split source for the active domain (via api/README.md) before hand-writing fetch payload/response types already defined by the contract."
    }
  }
}
