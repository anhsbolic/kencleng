// File: frontend/opencode.jsonc
//
// Assumes sibling repositories:
//   kencleng-workspace/
//   ├── kencleng/
//   └── harscode-workspace/
{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "workspace": {
      "path": "../../harscode-workspace",
      "description": "Generic Harscode workflow and engineering guidance. Use current repository authority; do not infer Pilot #3 product scope from historical Harscode/Kencleng artifacts."
    },
    "docs": {
      "path": "../docs",
      "description": "Kencleng product intent, reusable product-design authority, and project architecture. Release scope and delivery order are intentionally open until explicitly decided."
    },
    "api": {
      "path": "../api",
      "description": "OpenAPI tooling and the active shared contract when one exists. The clean baseline starts with no product operations defined."
    }
  }
}
