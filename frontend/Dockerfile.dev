FROM docker.io/library/node:24.22.1-bookworm-slim

ARG DEV_UID=1000
ARG DEV_GID=1000

RUN test "${DEV_UID}" -gt 0 && test "${DEV_GID}" -gt 0 \
    && if [ "${DEV_GID}" != "$(id -g node)" ]; then groupmod --gid "${DEV_GID}" node; fi \
    && if [ "${DEV_UID}" != "$(id -u node)" ]; then usermod --uid "${DEV_UID}" node; fi \
    && mkdir -p /workspace/frontend/node_modules /workspace/frontend/.next /home/node/.npm \
    && chown -R "${DEV_UID}:${DEV_GID}" /workspace /home/node

ENV HOME=/home/node \
    NODE_ENV=development \
    NEXT_TELEMETRY_DISABLED=1 \
    NPM_CONFIG_CACHE=/home/node/.npm
WORKDIR /workspace/frontend
COPY --chown=${DEV_UID}:${DEV_GID} package.json package-lock.json docker-dev.sh ./
USER ${DEV_UID}:${DEV_GID}
RUN sh ./docker-dev.sh --install

CMD ["sh", "./docker-dev.sh"]
