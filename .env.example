APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8090
DATABASE_URL=postgres://kencleng:kencleng@localhost:5435/kencleng?sslmode=disable

# Optional SeaweedFS local capability: root make storage-up. These are proposed
# client settings; the scaffold does not yet implement or consume an S3 client.
# Container backend endpoint: http://seaweedfs:8333. Presign using the public
# endpoint directly: replacing a signed URL's hostname invalidates its signature.
S3_ENDPOINT=http://127.0.0.1:9087
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9087
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=kencleng-local
S3_SECRET_ACCESS_KEY=kencleng-local-development-only
S3_BUCKET_PUBLIC=kencleng-public
S3_BUCKET_PRIVATE=kencleng-private
