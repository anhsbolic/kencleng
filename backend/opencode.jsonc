// File: backend/opencode.jsonc
//
// Assumes the local directory layout:
//   kencleng-workspace/
//   ├── kencleng/
//   └── harscode-workspace/
//
// Run OpenCode from backend/. Backend and frontend remain separate
// production write scopes by default. Shared docs/API are referenced
// explicitly for context without exposing frontend/ as normal write scope.
{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "workspace": {
      "path": "../../harscode-workspace",
      "description": "Generic portable workflow and engineering best-practices from Harscode. Harscode owns the per-feature lifecycle; Kencleng owns project-specific contracts and orchestration. Read workflow/README.md and best-practices/index.md as entry points."
    },
    "docs": {
      "path": "../docs",
      "description": "Kencleng project knowledge. Domain/feature truth lives under numbered docs/spec/<domain-dir>/ directories; docs/kencleng-agentic-workflow.md owns Kencleng project orchestration; docs/project/ owns project architecture/context. Use root/backend AGENTS.md to route to the smallest relevant authority set."
    },
    "api": {
      "path": "../api",
      "description": "OpenAPI 3.0.3 contract. Check openapi.yaml before hand-writing handler signatures or request/response DTOs whose shape is already defined by the contract."
    }
  }
}
