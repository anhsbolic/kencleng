// File: backend/opencode.jsonc
//
// Assumes the local directory layout:
//   kencleng-workspace/
//   ├── kencleng/              (this repo)
//   └── harscode-workspace/    (sibling repo, not part of kencleng)
//
// If harscode-workspace lives somewhere else on your machine, update
// "path" below accordingly. This file is committed to the kencleng repo —
// for anyone who forks kencleng without also having harscode-workspace
// checked out as a sibling, that one reference simply won't resolve; it
// doesn't error, it's just unused.
//
// Why "docs" and "api" are referenced individually (not the whole ".."):
// OpenCode is intentionally run from backend/, not from the repo root —
// backend and frontend are meant to stay separate sessions (see root
// AGENTS.md §7, "one vertical slice per session"). AGENTS.md files are
// picked up automatically via upward traversal regardless of cwd, but
// everything else — docs/spec/, docs/kencleng-agentic-workflow.md,
// api/openapi.yaml — sits above cwd and is invisible to read/glob tools
// by default. Referencing "docs" and "api" specifically (rather than
// ".." as a whole) restores access to that shared contract material
// without also exposing frontend/ to a backend session.
{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "workspace": {
      "path": "../../harscode-workspace",
      "description": "Generic, portable AI agent workflow guidance (code-review, testing, and pull-request phases; Go/PostgreSQL/REST-API best-practices). Secondary reference only — this project's own AGENTS.md and docs/spec/ take precedence wherever the two disagree. Read workflow/README.md as the entry point, and best-practices/index.md before applying any technology-specific checklist."
    },
    "docs": {
      "path": "../docs",
      "description": "Kencleng project docs: docs/spec/domains/<domain>/ (invariants, threat-model, tasks.md, feature specs — the contract for what to build) and docs/kencleng-agentic-workflow.md, docs/project/*.md (process, tech stack, repo setup). Read before starting any task."
    },
    "api": {
      "path": "../api",
      "description": "OpenAPI 3.0.3 spec (openapi.yaml) — source of truth for request/response contracts, used by oapi-codegen for Go types. Check this before hand-writing any handler signature or DTO."
    }
  }
}

