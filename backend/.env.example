APP_ENV=development
APP_PORT=8090
# Development auth only accepts this exact browser origin.
# Production requires APP_ENV=production and an HTTPS origin without a path.
APP_ORIGIN=http://localhost:8080

# Google OAuth client configuration, backend-only; fill locally.
# Register the exact callback: http://localhost:8080/api/auth/google/callback
# The callback is derived from APP_ORIGIN, not a separate environment variable.
# Configure consent/test-user access in Google before real-login testing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Application DB: use a restricted runtime role, not the Compose bootstrap user.
# Local endpoint example (replace credentials/database):
# postgres://<runtime_user>:<password>@localhost:5435/<database>?sslmode=disable
# URL-encode credentials containing reserved URL characters.
DATABASE_URL=

# Integration tests only: explicitly authorized DISPOSABLE PostgreSQL database.
# Never point this at production or shared application data.
# Existing integration tests create/drop isolated schemas and need a separate
# fixture/provisioning identity; this is not proof of restricted runtime access.
# Tests do not load .env automatically: export this variable before execution.
C1_AUTH_TEST_DATABASE_URL=

