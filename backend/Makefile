# backend/Makefile
verify: lint test-unit test-race test-contract security
lint:
	staticcheck ./...
	gosec ./...
test-unit:
	go test ./...
test-race:
	go test -race ./...
test-contract:
	go test -tags=contract ./...
security:
	gitleaks detect
	govulncheck ./...
migrate-up:
	migrate -path migrations -database "$$DATABASE_URL" up
migrate-down:
	migrate -path migrations -database "$$DATABASE_URL" down 1